APP_ENV=development
HOST=0.0.0.0
PORT=8080
# debug, info, warn or error. Defaults to debug in development and info elsewhere. Logs never contain
# SQL parameter values, tokens, passwords or full e-mail addresses.
# LOG_LEVEL=info
# Time allowed for in-flight requests and background queues to finish on SIGTERM; keep docker's
# stop_grace_period (45s in docker-compose.yml) longer than this.
SHUTDOWN_TIMEOUT=30s
# Comma separated IPs or CIDR ranges of the reverse proxies whose X-Forwarded-For header is believed.
# Empty (the default) trusts nobody, so a client cannot spoof its address. 0.0.0.0/0 and ::/0 are rejected.
# Rate limits are kept per process and per client IP (IPv6 clients are grouped by /64).
TRUSTED_PROXIES=

# Required.
DB_URL=host=127.0.0.1 user=postgres password=change-me dbname=rabbit_hole port=5432 sslmode=disable
TEST_DB_URL=host=127.0.0.1 user=postgres password=change-me dbname=rabbit_hole_test port=5432 sslmode=disable
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=25
DB_CONN_MAX_LIFETIME=1h
DB_CONN_MAX_IDLE_TIME=10m
# Per-session PostgreSQL limits (0 disables one). lock_timeout must not exceed statement_timeout.
DB_STATEMENT_TIMEOUT=30s
DB_LOCK_TIMEOUT=5s
DB_IDLE_IN_TX_TIMEOUT=1m
# Queries slower than this are logged as warnings (parameter values are never logged).
DB_SLOW_QUERY_THRESHOLD=200ms

POSTGRES_PASSWORD=change-me

# Required, at least 32 characters. The placeholder below is accepted only when APP_ENV is development or test.
JWT_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=168h
# Comma separated origins (scheme and host, no path or trailing slash); https:// in staging and production.
ALLOWED_ORIGINS=http://127.0.0.1:3000

# argon2id uses 64 MiB per hash. At most AUTH_HASH_CONCURRENCY hashes run at once (0 = number of CPUs);
# a request waits up to AUTH_HASH_WAIT for a slot and then gets 503 with Retry-After.
AUTH_HASH_CONCURRENCY=0
AUTH_HASH_WAIT=1s
# After AUTH_LOGIN_FAILURE_LIMIT failed sign-ins for one e-mail address in a row, further attempts are
# refused with the usual "invalid credentials" answer for AUTH_LOGIN_LOCK_BASE, doubling per failure up to
# AUTH_LOGIN_LOCK_MAX. Unknown addresses are tracked the same way. 0 disables the lock. Counters are per process.
AUTH_LOGIN_FAILURE_LIMIT=5
AUTH_LOGIN_LOCK_BASE=30s
AUTH_LOGIN_LOCK_MAX=15m
AUTH_LOGIN_TRACKED_ACCOUNTS=100000

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
PUBLIC_BASE_URL=http://127.0.0.1:8080
MAX_ATTACHMENT_BYTES=26214400
MAX_IMAGE_BYTES=10485760
# Optional cap for images re-hosted from a remote URL; defaults to MAX_IMAGE_BYTES.
# REHOST_MAX_BYTES=10485760
MAX_AVATAR_BYTES=5242880

# STORAGE_DRIVER=s3 stores files in MinIO or any S3-compatible bucket; the bucket must already exist.
S3_ENDPOINT=127.0.0.1:9000
S3_BUCKET=rabbit-hole
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-too
S3_REGION=us-east-1
S3_USE_SSL=false

# MAIL_DRIVER=log only writes mail to the server log (development). For a test mailbox run
# `docker compose --profile mail up` (Mailpit: web UI http://127.0.0.1:8025) and use
#   MAIL_DRIVER=smtp  SMTP_HOST=127.0.0.1  SMTP_PORT=1025  SMTP_SECURITY=none
# (inside Compose use SMTP_HOST=mailpit). Production needs a real SMTP server with starttls or tls.
MAIL_DRIVER=log
MAIL_FROM="Rabbit Hole <no-reply@localhost>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
# Must be https:// in staging and production. Setup, flows and troubleshooting: docs/mail.md.
# Links in mails point to the frontend: FRONTEND_URL/verify-email?token=... and /reset-password?token=...
FRONTEND_URL=http://127.0.0.1:3000
EMAIL_VERIFICATION_TTL=48h
PASSWORD_RESET_TTL=1h
REQUIRE_VERIFIED_EMAIL=false

# Notifications: at most this many notification e-mails per user per hour (extra ones are skipped, the in-app entry stays),
# and how many in-app entries are kept per user.
NOTIFICATION_EMAIL_PER_HOUR=30
NOTIFICATION_MAX_PER_USER=1000
# A webhook channel is disabled after this many consecutive failed deliveries.
NOTIFICATION_WEBHOOK_MAX_FAILURES=10

# Public forms: submissions per form per hour, the largest file a visitor may upload for a file question
# (bytes) and how long an upload waits for its submission before it is deleted.
FORM_SUBMISSIONS_PER_HOUR=200
FORM_UPLOAD_MAX_BYTES=10485760
FORM_UPLOAD_TTL=24h
