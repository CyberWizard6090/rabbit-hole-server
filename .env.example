APP_ENV=development
HOST=0.0.0.0
PORT=8080
TRUSTED_PROXIES=127.0.0.1,::1

DB_URL=host=127.0.0.1 user=postgres password=change-me dbname=rabbit_hole port=5432 sslmode=disable
TEST_DB_URL=host=127.0.0.1 user=postgres password=change-me dbname=rabbit_hole_test port=5432 sslmode=disable
DB_MAX_IDLE_CONNS=5
DB_MAX_OPEN_CONNS=25
DB_CONN_MAX_LIFETIME=1h

POSTGRES_PASSWORD=change-me

JWT_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=168h
ALLOWED_ORIGINS=http://127.0.0.1:3000

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
PUBLIC_BASE_URL=http://127.0.0.1:8080
MAX_ATTACHMENT_BYTES=26214400
MAX_IMAGE_BYTES=10485760
MAX_AVATAR_BYTES=5242880

# STORAGE_DRIVER=s3 stores files in MinIO or any S3-compatible bucket; the bucket must already exist.
S3_ENDPOINT=127.0.0.1:9000
S3_BUCKET=rabbit-hole
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-too
S3_REGION=us-east-1
S3_USE_SSL=false
