APP_ENV=development
HOST=0.0.0.0
PORT=8080
TRUSTED_PROXIES=127.0.0.1,::1

DB_URL=host=127.0.0.1 user=postgres password=change-me dbname=rabbit_hole port=5432 sslmode=disable
TEST_DB_URL=host=127.0.0.1 user=postgres password=change-me dbname=rabbit_hole_test port=5432 sslmode=disable
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=1h

POSTGRES_PASSWORD=change-me

JWT_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=168h
ALLOWED_ORIGINS=http://127.0.0.1:3000
